# Puerto de la API REST
PORT=3000

# Conexión MongoDB (Local o MongoDB Atlas Cloud)
# Local: mongodb://localhost:27017/eduportal
# Atlas: mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/eduportal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/eduportal

# Clave secreta JWT (mínimo 32 caracteres)
JWT_SECRET=super_secret_jwt_eduportal_2026_minedu_peru_development_key_secure_32

# Origen permitido por CORS (Frontend Angular 22)
CORS_ORIGIN=http://localhost:4200

# Contraseña inicial por defecto para nuevos usuarios/docentes/alumnos
DEFAULT_PASSWORD=12345678
